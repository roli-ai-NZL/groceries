# Optional. TheMealDB is used by default and needs no key.
# If set, Spoonacular is tried when TheMealDB has no match.
SPOONACULAR_API_KEY=

# Optional Coles online store + BFF key. Defaults work for Sydney-ish online prices.
# COLES_STORE_ID=0584
# COLES_SUBSCRIPTION_KEY=

# Optional. When Woolworths/Akamai blocks the Vercel (or other datacentre) IP,
# Estimate bill can fall back to an Apify Woolworths AU search actor.
# Create a free Apify account: https://console.apify.com/sign-up
# Then Settings → Integrations → create a personal API token.
# Add APIFY_TOKEN here for local runs, and in Vercel → Settings → Environment Variables
# (Production + Preview), then redeploy — new env vars are ignored until the next deploy.
# Open crawlerbros/woolworths-au-scraper in the Apify console once so the actor is accepted.
# APIFY_TOKEN=
# Optional override. Default is crawlerbros/woolworths-au-scraper (searchQuery + maxItems).
# APIFY_WOOLWORTHS_ACTOR=crawlerbros/woolworths-au-scraper
