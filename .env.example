# Optional. Share the grocery list across phone and laptop (Supabase free tier).
# Create a project at https://supabase.com, run supabase/schema.sql in the SQL
# editor (replace YOUR_HOUSEHOLD_ACCESS_CODE), then paste Project URL + anon key
# from Settings → API. Without these, the app keeps using localStorage only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. TheMealDB is used by default and needs no key.
# If set, Spoonacular is tried when TheMealDB has no match.
SPOONACULAR_API_KEY=

# Optional Coles online store + BFF key. Defaults work for Sydney-ish online prices.
# COLES_STORE_ID=0584
# COLES_SUBSCRIPTION_KEY=
